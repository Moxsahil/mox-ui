    "clsx": "^2.1.1",
    "figma-squircle": "^1.1.0",
    "flubber": "^0.4.2",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "next": "16.3.7",
    "next-themes": "^0.4.6",
    "prism-react-renderer": "^2.4.1",
    "react": "19.3.0",
    "react-apple-emojis": "^3.0.0",
    "react-dom": "19.3.0",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2"
